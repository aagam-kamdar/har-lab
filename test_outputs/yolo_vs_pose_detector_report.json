  "evidence_based_findings": {
    "detection_recall": "YOLOv8-Pose detected 7280 boxes vs Current YOLO 6784 boxes (+496 boxes, +7.3%). In difficult seated desk windows, Pose demonstrated modest incremental person detection recovery (Aagam window: 0 missed frames vs 3 for Base; Harshil window: 49 missed frames vs 267 for Base).",
    "bounding_box_tightness": "High mutual spatial agreement across matched detections (Mean IoU = 0.770, Median IoU = 0.830, 89.7% >= 0.50 IoU). Pose bounding boxes tend to encapsulate the full head-to-torso profile more reliably during seated typing.",
    "cpu_overhead": "YOLOv8-Pose achieved 29.2 FPS on CPU (34.3 ms/frame) compared to Current YOLO at 28.9 FPS (34.6 ms/frame), representing a -0.9% throughput reduction due to keypoint branch computation."
  }
